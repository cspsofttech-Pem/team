# Copy everything below into Streamlit Cloud → your app → Settings → Secrets.
# (Never upload a file with your real values to GitHub.)

# Supabase: Project Settings → API Keys (use the SECRET key, sb_secret_...)
supabase_url = "https://YOUR-PROJECT-ID.supabase.co"
supabase_key = "YOUR-SECRET-KEY"

# Team password: employees need it once, to register.
app_password = "change-me"

# Admin password: sign in on the "Admin" tab to see the dashboard.
admin_password = "choose-a-strong-admin-password"

# false = employees see everyone's tasks; true = employees see only their own tasks
employees_see_only_own = false

# Office time zone (used for "due today" reminders)
timezone = "Asia/Kolkata"
